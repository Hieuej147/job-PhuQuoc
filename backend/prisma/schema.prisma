generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ============================================================
// Enums
// ============================================================

enum Role {
  CANDIDATE
  EMPLOYER
  ADMIN
}

enum CompanySize {
  SIZE_1_50
  SIZE_51_200
  SIZE_201_500
  SIZE_500_PLUS
}

enum JobType {
  FULL_TIME
  PART_TIME
  REMOTE
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum ExperienceLevel {
  NO_EXPERIENCE
  UNDER_1_YEAR
  ONE_TO_THREE_YEARS
  THREE_TO_FIVE_YEARS
  OVER_FIVE_YEARS
}

enum JobLevel {
  INTERN
  FRESHER
  JUNIOR
  MID
  SENIOR
  LEAD
  MANAGER
  DIRECTOR
}

enum JobStatus {
  DRAFT
  PENDING
  ACTIVE
  CLOSED
  EXPIRED
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  ACCEPTED
  REJECTED
}

enum ApplicationMessageSenderRole {
  CANDIDATE
  EMPLOYER
}

enum NotificationType {
  APPLICATION_RECEIVED
  APPLICATION_ACCEPTED
  APPLICATION_REJECTED
  JOB_APPROVED
  COMPANY_APPROVED
  JOB_DEADLINE
  SYSTEM
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum CandidateQuotaPlan {
  CANDIDATE_FREE
  CANDIDATE_PLUS
}

enum EmployerQuotaPlan {
  EMPLOYER_BASIC
  EMPLOYER_PRO
}

enum JobCloseReason {
  EXPIRED
  EMPLOYER_CLOSED
  ADMIN_CLOSED
  EMPLOYER_ARCHIVED
}

enum BlogType {
  NORMAL
  LANDING_PAGE
}

// ============================================================
// better-auth core tables
// ============================================================

model user {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  imagePublicId String?
  role          Role?
  phone         String?
  isActive      Boolean  @default(true)
  isLocked      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts             account[]
  sessions             session[]
  company              Company?
  applications         JobApplication[]
  resumes              CandidateResume[]
  templates            ResumeTemplate[]
  notifications        Notification[]
  applicationMessages  ApplicationMessage[]
  savedJobs            SavedJob[]
  savedCompanies       SavedCompany[]
  blogs                BlogPost[]
  payments             Payment[]
  quotaPlan            UserQuotaPlan?
  quotaPurchases       QuotaPurchase[]
  chatThreads          ChatThread[]
}

model UserQuotaPlan {
  id            String             @id @default(cuid())
  userId        String             @unique
  candidatePlan CandidateQuotaPlan @default(CANDIDATE_FREE)
  employerPlan  EmployerQuotaPlan  @default(EMPLOYER_BASIC)
  candidatePlanExpiresAt DateTime?
  employerPlanExpiresAt  DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([candidatePlan])
  @@index([employerPlan])
  @@map("user_quota_plan")
}

model account {
  id                     String    @id @default(cuid())
  userId                 String
  accountId              String
  providerId             String
  accessToken            String?
  refreshToken           String?
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?
  scope                  String?
  idToken                String?
  password               String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model jwks {
  id         String    @id @default(cuid())
  publicKey  String
  privateKey String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
}

// ============================================================
// Address tables
// ============================================================

model AddressProvince {
  id        String           @id @default(cuid())
  name      String
  slug      String           @unique
  districts AddressDistrict[]

  @@map("address_province")
}

model AddressDistrict {
  id         String         @id @default(cuid())
  name       String
  slug       String
  provinceId String
  province   AddressProvince @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  wards      AddressWard[]

  @@index([provinceId])
  @@map("address_district")
}

model AddressWard {
  id         String         @id @default(cuid())
  name       String
  slug       String
  districtId String
  district   AddressDistrict @relation(fields: [districtId], references: [id], onDelete: Cascade)
  companies  Company[]
  jobs       Job[]

  @@index([districtId])
  @@map("address_ward")
}

// ============================================================
// Categories
// ============================================================

model JobCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  jobs      Job[]

  @@map("job_category")
}

// ============================================================
// Companies
// ============================================================

model Company {
  id            String      @id @default(cuid())
  name          String
  slug          String      @unique
  logo          String?
  logoPublicId  String?
  coverImage    String?
  coverImagePublicId String?
  website       String?
  description   String?
  wardId        String?
  addressDetail String?
  size          CompanySize?
  industry      String?
  ownerId       String      @unique
  isApproved    Boolean     @default(false)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  owner user        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ward  AddressWard? @relation(fields: [wardId], references: [id], onDelete: SetNull)
  jobs  Job[]
  savedCompanies SavedCompany[]

  @@index([ownerId])
  @@index([wardId])
  @@map("company")
}

// ============================================================
// Jobs
// ============================================================

model Job {
  id             String         @id @default(cuid())
  title          String
  slug           String         @unique
  description    String
  benefits       String?
  requirements   String?
  quantity       Int            @default(1)
  salaryMin      Int?
  salaryMax      Int?
  wardId         String?
  addressDetail  String?
  type           JobType        @default(FULL_TIME)
  experience     ExperienceLevel?
  level          JobLevel?
  status         JobStatus      @default(DRAFT)
  deadline       DateTime?
  publishedAt    DateTime?
  closedAt       DateTime?
  closeReason    JobCloseReason?
  durationDays   Int?
  boostLevel     Int            @default(0)
  featuredUntil  DateTime?
  activationId   String?
  currentPaymentId String?
  archivedAt     DateTime?
  archivedBy     String?
  archiveReason  String?
  categoryId     String
  companyId      String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  ward         AddressWard?    @relation(fields: [wardId], references: [id], onDelete: SetNull)
  category     JobCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications JobApplication[]
  savedJobs    SavedJob[]
  payments     Payment[]
  embedding    JobEmbedding?

  @@index([categoryId])
  @@index([companyId])
  @@index([status])
  @@index([status, deadline])
  @@index([archivedAt])
  @@index([featuredUntil, boostLevel])
  @@index([wardId])
  @@map("job")
}

model JobEmbedding {
  id        String   @id @default(cuid())
  jobId     String   @unique
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  embedding Unsupported("vector(768)")

  @@map("job_embedding")
}

// ============================================================
// Applications
// ============================================================

model JobApplication {
  id          String            @id @default(cuid())
  userId      String
  jobId       String
  cvUrl       String?
  resumeId    String?
  coverLetter String?
  status      ApplicationStatus @default(PENDING)
  employerMessage String?
  statusChangedAt DateTime?
  chatClosedAt DateTime?
  chatClosedBy String?
  chatCloseReason String?
  candidateDeletedAt DateTime?
  employerDeletedAt DateTime?
  isBookmarked Boolean          @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user   user?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  job    Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resume CandidateResume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  messages ApplicationMessage[]

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@index([userId, candidateDeletedAt])
  @@index([jobId, employerDeletedAt])
  @@map("job_application")
}

model ApplicationMessage {
  id                 String                       @id @default(cuid())
  applicationId      String
  senderId           String
  senderRole         ApplicationMessageSenderRole
  body               String
  readAt             DateTime?
  hiddenForCandidate Boolean                      @default(false)
  hiddenForEmployer  Boolean                      @default(false)
  createdAt          DateTime                     @default(now())

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  sender      user           @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@index([senderId, createdAt])
  @@map("application_message")
}

// ============================================================
// Resumes
// ============================================================

model CandidateResume {
  id          String   @id @default(cuid())
  userId      String
  title       String   @default("Hồ sơ của tôi")
  address     String?
  summary     String?
  socialLinks Json?
  education   Json?
  experience  Json?
  projects    Json?
  skills      String?
  degree      String?
  languages   String?
  name        String?
  email       String?
  phone       String?
  avatar      String?
  avatarPublicId String?
  isDefault   Boolean  @default(false)
  templateId  String
  isProfile   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         user           @relation(fields: [userId], references: [id], onDelete: Cascade)
  template     ResumeTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  applications JobApplication[]

  @@index([userId])
  @@index([userId, isProfile])
  @@map("candidate_resume")
}

model ResumeTemplate {
  id           String   @id @default(cuid())
  name         String
  description  String?
  previewUrl   String?
  isPublic     Boolean  @default(false)
  userId       String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     user?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumes  CandidateResume[]

  @@index([isPublic, isActive])
  @@index([userId])
  @@map("resume_template")
}

// ============================================================
// Notifications
// ============================================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  content   String
  refId     String?
  refType   String?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  expiresAt DateTime?
  dedupeKey String?
  createdAt DateTime         @default(now())

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([userId, isRead, createdAt])
  @@index([expiresAt])
  @@index([refType, refId])
  @@map("notification")
}

// ============================================================
// Saved Jobs & Companies
// ============================================================

model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@map("saved_job")
}

model SavedCompany {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  createdAt DateTime @default(now())

  user    user    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@map("saved_company")
}

// ============================================================
// Blogs
// ============================================================

model BlogPost {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  type           BlogType  @default(NORMAL)
  content        Json?
  landingContent Json?
  thumbnail      String?
  excerpt        String?
  categoryId     String?
  authorId       String
  views          Int       @default(0)
  isPublished    Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  category BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author   user          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([categoryId])
  @@map("blog_post")
}

model BlogCategory {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  createdAt DateTime   @default(now())
  blogs     BlogPost[]

  @@map("blog_category")
}

// ============================================================
// Pricing Packages
// ============================================================

model PricingPackage {
  id        String   @id @default(cuid())
  name      String
  days      Int
  price     Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  payments  Payment[]

  @@map("pricing_package")
}

// ============================================================
// Payments
// ============================================================

model Payment {
  id          String        @id @default(cuid())
  userId      String
  jobId       String
  packageId   String
  amount      Int
  listingAmount Int?
  boostAmount Int       @default(0)
  durationDays Int?
  boostLevel  Int       @default(0)
  activationId String?
  status      PaymentStatus @default(PENDING)
  gateway     String        @default("mock")
  gatewayRef  String?
  createdAt   DateTime      @default(now())
  completedAt DateTime?

  user    user           @relation(fields: [userId], references: [id], onDelete: Cascade)
  job     Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  package PricingPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([jobId])
  @@index([gatewayRef])
  @@map("payment")
}

// ============================================================
// Quota Packages & Purchases
// ============================================================

model QuotaPackage {
  id             String   @id @default(cuid())
  name           String
  targetPlan     String
  durationMonths Int
  price          Int
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  purchases      QuotaPurchase[]

  @@index([targetPlan])
  @@index([isActive])
  @@map("quota_package")
}

model QuotaPurchase {
  id             String        @id @default(cuid())
  userId         String
  packageId      String
  targetPlan     String
  amount         Int
  durationMonths Int
  status         PaymentStatus @default(PENDING)
  gateway        String        @default("mock")
  gatewayRef     String?       @unique
  startsAt       DateTime?
  expiresAt      DateTime?
  createdAt      DateTime      @default(now())
  completedAt    DateTime?

  user    user         @relation(fields: [userId], references: [id], onDelete: Cascade)
  package QuotaPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([packageId])
  @@index([status])
  @@index([expiresAt])
  @@map("quota_purchase")
}

// ============================================================
// Audit Logs
// ============================================================

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String?
  entityId   String?
  actorId    String?
  oldValue   String?
  newValue   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_log")
}

// ============================================================
// Chat Threads (AI Agent)
// ============================================================

enum ChatAgentType {
  CANDIDATE
  RECRUITER
}

model ChatThread {
  id        String        @id @default(cuid())
  userId    String
  agentType ChatAgentType
  title     String        @default("Cuộc trò chuyện mới")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, agentType, updatedAt])
  @@map("chat_thread")
}
