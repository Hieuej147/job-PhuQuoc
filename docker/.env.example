# ============================================================
# Backend (.env)
# ============================================================

# Database
DATABASE_URL="postgresql://pq_user:pq_pass123@localhost:5435/pq_jobs"

# Redis
REDIS_URL="redis://localhost:6381"

# Auth (better-auth)
BETTER_AUTH_SECRET="your-secret-key-min-32-characters-long"
BETTER_AUTH_URL="http://localhost"
BACKEND_PUBLIC_URL="http://localhost"

# Frontend
FRONTEND_URL="http://localhost:3001"

# Agent
AGENT_URL="http://localhost:8125"

# Inngest (dev mode)
INNGEST_DEV=1

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email - Resend (optional)
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"

# Stripe (optional)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ============================================================
# Frontend (web/.env)
# ============================================================

# Backend URL (for SSR calls)
BACKEND_URL="http://localhost:3006"
NEXT_PUBLIC_API_URL="http://localhost"
NEXT_PUBLIC_REALTIME_URL="http://localhost"

# Agent URL
AGENT_URL="http://localhost:8125"

# OpenAI (for AI agent and backend chat thread title generation)
OPENAI_API_KEY="sk-..."
CHAT_THREAD_TITLE_MODEL="gpt-4o-mini"

# CopilotKit (optional)
NEXT_PUBLIC_COPILOTKIT_API_KEY=""
COPILOTKIT_LICENSE_TOKEN=""
INTELLIGENCE_API_KEY=""
INTELLIGENCE_API_URL=""
INTELLIGENCE_GATEWAY_WS_URL=""
